<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_secondary"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JARVIS AI SETTINGS"
        android:textColor="@color/cyan_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp" />

    <!-- Gemini API Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Google Gemini API Key"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dynamic conversational AI answers (Gemini 2.0 / 1.5 Flash)"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter Gemini API key..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textPassword"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Groq API Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Groq Cloud API Key (Optional)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ultra-fast LLaMA 3.3 / Mixtral inference"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etGroqApiKey"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="gsk_..."
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textPassword"
        android:singleLine="true"
        android:layout_marginBottom="16dp" />

    <!-- Wake Word Required Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Require Wake Word 'Jarvis'"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="When off, all spoken words are processed directly"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchWakeWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Audio Speech Output Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice Audio Feedback (TTS)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spoken verbal replies through device speaker"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAudioFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Hardware Permissions & Consents Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARDWARE PERMISSIONS &amp; CONSENT"
        android:textColor="@color/cyan_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status of hardware controls remembered across sessions:"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvHardwarePermStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wi-Fi: Granted • Bluetooth: Granted • Torch: Granted\nCamera: Granted • Volume: Granted • DND: Granted"
        android:textColor="@color/text_body"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnOpenDeviceAdminPermissions"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="🛡️ Authorize Device Admin &amp; Permissions"
        android:textColor="@color/cyan_primary"
        android:textSize="11sp"
        app:strokeColor="@color/cyan_primary"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnResetHardwarePermissions"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Reset All Hardware Consents"
        android:textColor="@color/ruby_error"
        android:textSize="11sp"
        app:strokeColor="@color/ruby_error"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnViewStartupLogs"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="View Startup Logs &amp; Diagnostics"
        android:textColor="@color/cyan_primary"
        android:textSize="11sp"
        app:strokeColor="@color/cyan_primary"
        android:layout_marginBottom="16dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Save Settings"
            android:textColor="@color/bg_primary"
            android:backgroundTint="@color/cyan_primary" />
    </LinearLayout>

</LinearLayout>
